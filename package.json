{
  "name": "spaces",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r run start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check-license": "bun run scripts/check-license.ts",
    "secret-scan": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.1",
    "eslint": "^9.21.0",
    "lefthook": "^1.11.3",
    "prettier": "^3.5.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "secretlint": "^9.0.1",
    "typescript-eslint": "^8.24.1"
  }
}
