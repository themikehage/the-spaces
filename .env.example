# SPDX-License-Identifier: MIT
# ==============================================================================
# Spaces - Environment Variables Configuration
# ==============================================================================

# ── Requerido / Core ─────────────────────────────────────────────────────────

# SPACES_AUTH_SECRET: Secret for signing JWTs and session tokens.
# If omitted in development, a transient key will be auto-generated at startup.
# In production, set a static secret so sessions survive server restarts.
SPACES_AUTH_SECRET=your-random-32-character-secret-key

# SPACES_DATA_PATH: Base directory for persistent user data, DB, and sessions.
# Default: ~/.spaces-data (Linux/macOS) or %APPDATA%/spaces-data (Windows)
# SPACES_DATA_PATH=/var/lib/spaces-data

# PORT: HTTP server port. Default: 3000
PORT=3000

# ── Preview Configuration ───────────────────────────────────────────────────

# PREVIEW_HOST: Domain header for the preview proxy server (e.g. preview.localhost)
# PREVIEW_HOST=localhost

# PREVIEW_PORT: Dedicated port for serving web app previews. Default: 3001
PREVIEW_PORT=3001

# ── AI Provider Keys (Optional via .env — Can also be configured in UI) ──────
# Provider API keys are stored encrypted in the local SQLite database when configured
# via the Settings UI. You may optionally set default fallback keys below:

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# EXA_API_KEY=...
