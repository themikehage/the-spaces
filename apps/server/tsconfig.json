{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@spaces/sdk-core": ["../../packages/sdk-core/src/index.ts"],
      "@spaces/sdk-runtime": ["../../packages/sdk-runtime/src/index.ts"],
      "@spaces/sdk-tools": ["../../packages/sdk-tools/src/index.ts"],
      "@spaces/sdk-providers": ["../../packages/sdk-providers/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/ai/vendor"]
}
